{
  "name": "family-finances",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "build:dev": "eas build -p android --profile development",
    "build:apk": "eas build -p android --profile preview",
    "build:store": "eas build -p android --profile production",
    "build:apk:local": "eas build -p android --profile preview --local",
    "build:store:local": "eas build -p android --profile production --local",
    "start:emulator": "emulator -avd Pixel_2_API_33",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "jest --no-coverage",
    "test:coverage": "jest --coverage --coverageReporters=text",
    "test:security": "jest --testPathPattern='__tests__/security' --no-coverage"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.2.3",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^6.5.7",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/stack": "^6.3.16",
    "@shopify/react-native-skia": "2.6.2",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.7",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "expo": "~57.0.19",
    "expo-build-properties": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-local-authentication": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "^57.0.2",
    "expo-status-bar": "~57.0.1",
    "formik": "^2.2.9",
    "nativewind": "^4.1",
    "openai": "^4.28.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-chart-kit": "^6.12.0",
    "react-native-csv": "^0.2.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-loading-dots": "^1.3.2",
    "react-native-markdown-display": "^7.0.2",
    "react-native-progress": "^5.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^1.3.0",
    "react-native-worklets": "0.10.1",
    "reacticx": "^0.1.10",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/jest-native": "^5.4",
    "@testing-library/react-native": "^13",
    "@types/node": "^20.12.0",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^9.0.0",
    "jest": "29",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.17",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "expo-sqlite",
        "expo",
        "expo-build-properties",
        "expo-document-picker",
        "expo-file-system",
        "expo-font",
        "expo-linear-gradient",
        "expo-local-authentication",
        "expo-secure-store",
        "expo-splash-screen",
        "eslint-config-expo"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-css-interop"
        ]
      }
    }
  }
}
