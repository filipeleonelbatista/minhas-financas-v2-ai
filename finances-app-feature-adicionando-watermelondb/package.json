{
  "name": "family-finances",
  "version": "1.0.0",
  "scripts": {
    "prebuild": "expo prebuild",
    "clean-android": "cd android && ./gradlew clean && cd ..",
    "clean-ios": "cd ios && rm -rf Pods && rm -rf Podfile.lock && pod cache clean --all && pod deintegrate && pod setup && cd ..",
    "android:build:apk": "cd android && ./gradlew assembleRelease && cd ..",
    "android:build:aab": "cd android && ./gradlew bundleRelease && cd ..",
    "android:build:apk:install": "cd android && ./gradlew installRelease && cd ..",
    "android:build:aab:install": "cd android && ./gradlew installRelease && cd ..",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev": "eas build -p android --profile development",
    "build:apk": "eas build -p android --profile preview",
    "build:store": "eas build -p android --profile production",
    "build:apk:local": "eas build -p android --profile preview --local",
    "build:store:local": "eas build -p android --profile production --local",
    "start:emulator": "emulator -avd Pixel_2_API_33"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.2.3",
    "@nozbe/watermelondb": "^0.26.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/hooks": "^3.0.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^6.5.7",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/stack": "^6.3.16",
    "axios": "^1.4.0",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.7",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-media-library": "~18.2.1",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "formik": "^2.2.9",
    "jest-expo": "~54",
    "native-base": "^3.4.28",
    "nativewind": "^4.1",
    "openai": "^3.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-csv": "^0.2.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-linear-gradient": "^2.6.2",
    "react-native-loading-dots": "^1.3.2",
    "react-native-progress": "^5.0.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^1.3.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^4",
    "xlsx": "^0.18.5",
    "yup": "^1.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-proposal-decorators": "^7.22.7",
    "@testing-library/jest-native": "^5.4",
    "@testing-library/react-native": "^13",
    "jest": "29",
    "jest-environment-jsdom": "^30.5.0",
    "react-test-renderer": "19.1.0"
  },
  "private": true
}
